# Αντίγραψε σε frontend/.env.production (για το build του server). ΜΗΝ βάζεις εδώ μυστικά:
# ό,τι ξεκινά με VITE_ μπαίνει μέσα στο JavaScript της σελίδας και το βλέπει όποιος την ανοίξει.

# Η δημόσια διεύθυνση (για την εικόνα προεπισκόπησης og:image και τα canonical links)
VITE_PUBLIC_URL=https://το-domain-σου
# Email επικοινωνίας που εμφανίζεται στην Πολιτική απορρήτου / Όρους (κενό = φόρμα «Επικοινωνία»)
VITE_CONTACT_EMAIL=
# Προαιρετικά analytics χωρίς cookies (Plausible / Umami). Κενό = κανένα.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
# Clerk: το δημόσιο κλειδί (pk_...) από το Clerk Dashboard → API keys (ίδιο με το CLERK_PUBLISHABLE_KEY του server)
VITE_CLERK_PUBLISHABLE_KEY=
