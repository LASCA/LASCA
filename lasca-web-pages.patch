+# Αντίγραψε αυτό το αρχείο σε code/.env και συμπλήρωσε τις τιμές.
+# Το code/.env ΔΕΝ ανεβαίνει ποτέ στο git.
+
+# Τυχαίο μυστικό για τα cookies σύνδεσης. Φτιάξε ένα με:
+#   python -c "import secrets; print(secrets.token_hex(32))"
+SECRET_KEY=
+
+# 0 τοπικά (http://localhost), 1 στον server (https://το-domain-σου)
+COOKIE_SECURE=0
+
+# Πόσες μέρες κρατάει το «Να με θυμάσαι»
+REMEMBER_ME_DAYS=30
+
+# Φάκελος για avatars κ.λπ. και η βάση χρηστών
+LASCA_DATA=./local_data
+LASCA_SQLITE_DB=./local_data/lasca.db
+
+# Σύνδεση με Google (προαιρετικό). Αν μείνει κενό, το κουμπί Google απλά δεν εμφανίζεται.
+# Client ID από Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
+GOOGLE_CLIENT_ID=
+
+# Φόρμα επικοινωνίας (Resend)
+RESEND_API_KEY=
+NOTIFICATION_EMAIL=
