# Αντιγραφή στον server ως /srv/lasca/code/.env και συμπλήρωση.
# ΔΕΝ υπάρχει LASCA_ENV εδώ: έτσι το dev_tools.py δεν τρέχει ποτέ στον server.

# Νέο, διαφορετικό από του υπολογιστή σου:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ο server έχει HTTPS, οπότε τα cookies στέλνονται μόνο με HTTPS
COOKIE_SECURE=1
REMEMBER_ME_DAYS=30

# Δεδομένα χρηστών έξω από τον φάκελο του κώδικα (δεν τα αγγίζει το git pull)
LASCA_DATA=/srv/lasca-data
LASCA_SQLITE_DB=/srv/lasca-data/lasca.db
LASCA_PROJECTS_DIR=/srv/lasca-data/projects
FEEDBACK_UPLOAD_FOLDER=/srv/lasca-data/feedback_uploads

# Η δημόσια διεύθυνση της σελίδας (για τους συνδέσμους πρόσκλησης)
PUBLIC_URL=https://το-domain-σου

GOOGLE_CLIENT_ID=
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# --- Ασφάλεια (βλ. code/auth_security.py και code/security.py) ---
# Cloudflare Turnstile (δωρεάν CAPTCHA, χωρίς cookies παρακολούθησης):
#   dash.cloudflare.com → Turnstile → Add widget → domain σου → Site key / Secret key
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Αποστολέας για emails επαναφοράς κωδικού / κωδικών 2FA (το domain πρέπει να είναι verified στο Resend)
EMAIL_FROM=LASCA <no-reply@το-domain-σου>
# Ανώτατο πλήθος emails τη μέρα (προστασία κόστους Resend)
MAX_EMAILS_PER_DAY=200
# Έλεγχος κωδικών στο haveibeenpwned (στέλνονται μόνο 5 χαρακτήρες του hash). 0 για απενεργοποίηση.
HIBP_CHECK=1
# Ελάχιστη ηλικία εγγραφής (Ελλάδα: 15 για ψηφιακή συναίνεση, GDPR άρθρο 8)
MIN_SIGNUP_AGE=15
# Κλειδί κρυπτογράφησης για τα μυστικά 2FA και τους εφεδρικούς κωδικούς. Βάλ' το ΜΙΑ φορά και μην το αλλάξεις
# (αλλιώς κανείς δεν θα μπορεί να περάσει το 2FA). Έτσι μπορείς να αλλάξεις το SECRET_KEY χωρίς πρόβλημα.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
TOTP_ENCRYPTION_KEY=
# Όρια χρήσης
MAX_PROJECTS_PER_USER=100
MAX_MEMBERS_PER_PROJECT=50
MAX_ACTIVE_INVITES=20
MAX_REQUEST_MB=8
DEVICE_TOKEN_IDLE_DAYS=90
# Επιπλέον επιτρεπτές προελεύσεις για αιτήματα (π.χ. https://www.το-domain-σου), χωρισμένες με κόμμα
ALLOWED_ORIGINS=
# Προαιρετικά analytics χωρίς cookies (π.χ. Plausible / Umami): η διεύθυνση του script
# (και VITE_ANALYTICS_SRC / VITE_ANALYTICS_DOMAIN στο frontend/.env.production). Κενό = κανένα analytics.
ANALYTICS_ORIGIN=
