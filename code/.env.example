# Αντίγραψε αυτό το αρχείο σε code/.env και συμπλήρωσε τις τιμές.
# Το code/.env ΔΕΝ ανεβαίνει ποτέ στο git.

# Τυχαίο μυστικό για τα cookies σύνδεσης (τουλάχιστον 32 χαρακτήρες). Φτιάξε ένα με:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 0 τοπικά (http://localhost), 1 στον server (https://το-domain-σου)
COOKIE_SECURE=0

# Πόσες μέρες κρατάει το «Να με θυμάσαι»
REMEMBER_ME_DAYS=30

# ΜΟΝΟ στον υπολογιστή σου: ενεργοποιεί το code/dev_tools.py (reset / seed χρηστών δοκιμής).
# Στον server (Oracle) ΜΗΝ το βάλεις.
LASCA_ENV=development

# Φάκελοι δεδομένων (οι σχετικές διαδρομές μετράνε από τον φάκελο LASCA του repo)
LASCA_DATA=./local_data
LASCA_SQLITE_DB=./local_data/lasca.db
LASCA_PROJECTS_DIR=./local_data/projects

# Η δημόσια διεύθυνση της σελίδας (για τους συνδέσμους πρόσκλησης). Τοπικά: http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Σύνδεση με Google (προαιρετικό). Αν μείνει κενό, το κουμπί Google απλά δεν εμφανίζεται.
# Client ID από Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Φόρμα επικοινωνίας (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# --- Ασφάλεια (βλ. code/auth_security.py και code/security.py) ---
# Cloudflare Turnstile (δωρεάν CAPTCHA, χωρίς cookies παρακολούθησης):
#   dash.cloudflare.com → Turnstile → Add widget → domain σου → Site key / Secret key
# Για τοπική δοκιμή υπάρχουν «κλειδιά δοκιμής» της Cloudflare που περνάνε πάντα:
# developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Αποστολέας για emails επαναφοράς κωδικού / κωδικών 2FA (το domain πρέπει να είναι verified στο Resend)
EMAIL_FROM=LASCA <onboarding@resend.dev>
# Ανώτατο πλήθος emails τη μέρα (προστασία κόστους Resend)
MAX_EMAILS_PER_DAY=200
# Έλεγχος κωδικών στο haveibeenpwned (στέλνονται μόνο 5 χαρακτήρες του hash). 0 για απενεργοποίηση.
HIBP_CHECK=1
# Ελάχιστη ηλικία εγγραφής (Ελλάδα: 15 για ψηφιακή συναίνεση, GDPR άρθρο 8)
MIN_SIGNUP_AGE=15
# Προαιρετικό: ξεχωριστό κλειδί κρυπτογράφησης για τα μυστικά 2FA (αλλιώς από το SECRET_KEY).
# ΠΡΟΣΟΧΗ: αν αλλάξει το SECRET_KEY χωρίς αυτό, οι χρήστες πρέπει να ξαναρυθμίσουν το 2FA.
TOTP_ENCRYPTION_KEY=
# Όρια χρήσης
MAX_PROJECTS_PER_USER=100
MAX_MEMBERS_PER_PROJECT=50
MAX_ACTIVE_INVITES=20
MAX_REQUEST_MB=8
DEVICE_TOKEN_IDLE_DAYS=90
# Επιπλέον επιτρεπτές προελεύσεις για αιτήματα (π.χ. https://www.το-domain-σου), χωρισμένες με κόμμα
ALLOWED_ORIGINS=
# Προαιρετικά analytics χωρίς cookies (π.χ. Plausible / Umami): η διεύθυνση του script
# (και VITE_ANALYTICS_SRC / VITE_ANALYTICS_DOMAIN στο frontend/.env.production). Κενό = κανένα analytics.
ANALYTICS_ORIGIN=
